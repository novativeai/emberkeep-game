node_modules/
dist/
test-results/
# Parallel verify lanes (`pnpm verify:lane`) build to dist-<id> and write their
# traces to test-results-<id>, so several agents can verify one checkout at once
# without reading each other's build. Generated output — never committed.
dist-*/
test-results-*/
# …and their screenshots. `tests/e2e/shots/` is the authored reference set; a lane
# writes shots-<id>/ beside it, and those are one run's artefacts, not the repo's.
tests/e2e/shots-*/
playwright-report/
.playwright-mcp/
.vercel/
.DS_Store
*.local
*.log

# local debug screenshots (verification shots live in tests/e2e/shots/)
/board-dragon-clouds.png
/passive-gift-check.png
/title-check.png
/title-new.png

# loose junk / root duplicates (canonical copies live under assets/)
/log.txt
/full-water-bg.jpg
/dragon-land.world.json

# World-builder project files — large authoring artifacts (28 MB each).
# The game runs from src/data/map.json (generated); keep these locally but
# never commit them so clone stays fast.
assets/map/*.json
assets/map/*.worldproject.json
# …except the editor export tests/unit/Worlds.spec.ts typechecks against (156 KB).
!assets/map/nionja-worlds.json

# Root-level source / duplicate art folders — canonical copies live under assets/sprites/.
# e2e shots are generated output, not baselines — re-run `pnpm e2e` to regenerate.
asset-reference/
Islands/
Decors/
egs/
reward/
payment/
logo/
tests/e2e/shots/
before-bubble-camera.png

# Art GENERATION WORKSPACE — 3.9 GB of full-resolution masters, briefs and
# rejected passes. Nothing here is fetched by the running game (vite.config.ts
# default-denies `raw/` on the way into dist); what ships is promoted into
# assets/sprites/ as a sized, converted file. The CC0 screamingbrain tileset
# and the raw/ai placeholders were committed before this rule and stay tracked.
assets/raw/

# loose working files at the repo root (masks, base64 scratch, screenshot dumps
# from a shell whose $SCRATCH never expanded)
/$SCRATCH/
/bevel-*-test.png
/stage1.txt
/emberkeep-mask.png
/emberkeep-mask*

# Tool scratch output — mapmask writes its probability fields and check renders
# here on every run (26 MB, regenerated by re-running the tool).
tools/mapmask/out/

# external standalone tools that carry their own .git (not part of this repo)
/rigger/
/world/

# personal Claude Code permissions (local)
.claude/settings.local.json

# API keys — never commit
.env

# Claude Code agent worktrees (large, transient)
.claude/worktrees/

# session debug screenshots (root)
/app-title.jpg
/app-title-real.jpg
/face-animator-canvas.png
/face-animator-initial.png
/laurah-world-initial.png

# EmberGames hub — its own git repo (github.com/novativeai/embergames)
embergames/

__pycache__/

# Spotlight exclusion markers (mds_stores re-indexes multi-GB build/workspace trees)
.metadata_never_index

# beat checkpoints: the save blobs are committed, the screenshots are regenerated
tests/e2e/checkpoints/*.png
.vercel
.env*
