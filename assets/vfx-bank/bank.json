{
  "format": "emberkeep-vfx-bank",
  "version": 1,
  "note": "AAA VFX bank for Emberkeep. Every entry is baked by scripts/bake-vfx-bank.mjs through the FX Studio engine (tools/fxstudio/index.html), so the bank and the authoring tool can never drift. Sources are CC0 packs from Simon Schreibt's Textures-for-VFX database; colour ramps are the real src/core/Constants.ts PALETTE. Stills use the full technique chain; sheets use the per-pixel grade only (spatial ops would bleed across flipbook cells). Author on black: everything marked blend:add reads correctly under Phaser.BlendModes.ADD.",
  "conventions": {
    "blend": "add = additive (author on black, alpha carries intensity); normal = alpha-over",
    "maxTexturePx": 4096,
    "sheetOrder": "left-to-right, top-to-bottom",
    "credits": "assets/CREDITS.md"
  },
