# Cloudflare R2 (S3-compatible) — same variable names as stock-ai-backend, so
# one set of credentials serves both projects.
# Without these the app falls back to ./data/project.json on local disk and
# file attachments are disabled.
R2_ACCOUNT_ID=your-account-id
R2_ACCESS_KEY_ID=your-r2-access-key
R2_SECRET_ACCESS_KEY=your-r2-secret-key
R2_BUCKET_NAME=emberkeep
# Optional: full endpoint instead of the account id
# R2_ENDPOINT_URL=https://your-account.r2.cloudflarestorage.com
# Optional: where the project JSON lives in the bucket
# R2_PROJECT_KEY=emberkeep/project.json
