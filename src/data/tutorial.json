{
  "steps": [
    {
      "id": "arrival_miss",
      "speaker": "eleanor",
      "text": "Oh! You landed in the wrong spot.",
      "gate": {
        "type": "tap"
      },
      "allow": {}
    },
    {
      "id": "arrival_place",
      "speaker": "eleanor",
      "text": "Welcome to Emberkeep. I tried to bring you to the big hall, but my spell dropped you here instead.",
      "gate": {
        "type": "tap"
      },
      "allow": {}
    },
    {
      "id": "arrival_ash",
      "speaker": "eleanor",
      "text": "Careful where you step. That grey stuff is ash. Long ago, a huge fire went out here all at once.",
      "gate": {
        "type": "tap"
      },
      "allow": {}
    },
    {
      "id": "arrival_slip",
      "speaker": "eleanor",
      "text": "What put the fire out? I have wondered for years. I read every book about it. I was—",
      "gate": {
        "type": "tap"
      },
      "allow": {}
    },
    {
      "id": "arrival_hold",
      "speaker": "eleanor",
      "text": "…Never mind. I will tell you that story later.",
      "gate": {
        "type": "tap"
      },
      "allow": {}
    },
    {
      "id": "arrival_why",
      "speaker": "eleanor",
      "text": "Here is why I called YOU: when you landed, the ash under your hands got warm. That has not happened in sixty years.",
      "gate": {
        "type": "tap"
      },
      "allow": {}
    },
    {
      "id": "arrival_ask",
      "speaker": "eleanor",
      "text": "So I need your help. Let's bring Emberkeep back to life: the warmth, the plants, and the dragons sleeping under the ash. You can do it, Keeper.",
      "gate": {
        "type": "tap"
      },
      "allow": {}
    },
    {
      "id": "moss_stump",
      "speaker": "eleanor",
      "text": "See that old burnt stump? Moss is growing on it. Tap the stump to pick a Moss Puff. It will always grow more.",
      "gate": {
        "type": "event",
        "event": "item:harvested",
        "chain": "ashmoss"
      },
      "effects": [
        {
          "spawn": {
