    {
      "id": "name_intro",
      "speaker": "eleanor",
      "text": "Look at her. She has picked you out of everything on this isle and she is waiting. Give her a name, Keeper. I'll not have her called 'the dragon'.",
      "gate": {
        "type": "tap"
      },
      "highlight": [
        {
          "chain": "ember_dragon",
          "nth": 0,
          "tier": 3
        }
      ],
      "allow": {}
    },
    {
      "id": "name_choose",
      "speaker": "eleanor",
      "text": "Go on. Whatever you settle on, she will answer to it for the rest of her life.",
      "gate": {
        "type": "event",
        "event": "dragon:named",
        "chain": "ember_dragon"
      },
      "effects": [
        {
