    {
      "id": "dragon_rest",
      "speaker": "laurah",
      "text": "Hard work tires even dragons! After 3 minutes they need rest. Watch — your dragon just nodded off. Warmth Emporium has you covered — tap the ⚡ button to refill!",
      "gate": { "type": "tap" },
      "effects": [
        { "advanceClock": 185000 }
      ],
      "arrow": { "ui": "marketplace" },
      "allow": {}
    },
    {
      "id": "buy_energy",
      "speaker": "laurah",
      "text": "Your first Ember Spark — on the house! Tap the ⚡ + button at the top to open the Emporium and claim it free. Just this once!",
      "gate": { "type": "event", "event": "marketplace:purchased" },
      "arrow": { "ui": "marketplace" },
      "allow": { "marketplace": true }
